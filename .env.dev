# -----------------------------------------------------------------------------
# App
# -----------------------------------------------------------------------------
NEXT_PUBLIC_APP_URL=http://localhost:3000

# -----------------------------------------------------------------------------
# Database (PostgreSQL — docker сервис "db")
# -----------------------------------------------------------------------------
DATABASE_URL=postgresql://leo:leo_password@db:5432/leo?schema=public

# -----------------------------------------------------------------------------
# Authentication (NextAuth.js / Auth.js)
# -----------------------------------------------------------------------------
# Сгенерировать: openssl rand -base64 32
AUTH_SECRET=your-auth-secret-min-32-chars-here-change-me

# Google OAuth — redirect: http://localhost:3000/api/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

GITHUB_OAUTH_TOKEN=

# -----------------------------------------------------------------------------
# Email (Resend)
# -----------------------------------------------------------------------------
RESEND_API_KEY=
EMAIL_FROM=Leo <noreply@example.com>

# -----------------------------------------------------------------------------
# Stripe (тестовые ключи sk_test_...)
# -----------------------------------------------------------------------------
STRIPE_API_KEY=
STRIPE_WEBHOOK_SECRET=

NEXT_PUBLIC_STRIPE_PRO_MONTHLY_PLAN_ID=
NEXT_PUBLIC_STRIPE_PRO_YEARLY_PLAN_ID=
NEXT_PUBLIC_STRIPE_BUSINESS_MONTHLY_PLAN_ID=
NEXT_PUBLIC_STRIPE_BUSINESS_YEARLY_PLAN_ID=

# -----------------------------------------------------------------------------
# Сервисы (gateway и orchestrator снаружи Docker — через host)
# -----------------------------------------------------------------------------
# URL для клиентского браузера (открытые порты на localhost)
NEXT_PUBLIC_AI_GATEWAY_URL=http://localhost:8080
NEXT_PUBLIC_AGENT_ORCHESTRATOR_URL=http://localhost:8081

# URL для server-side запросов внутри контейнера (через host.docker.internal)
AI_GATEWAY_URL=http://host.docker.internal:8080
AGENT_ORCHESTRATOR_URL=http://host.docker.internal:8081

# -----------------------------------------------------------------------------
# Apify
# -----------------------------------------------------------------------------
APIFY_API_TOKEN=
