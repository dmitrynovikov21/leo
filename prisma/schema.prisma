// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider     = "postgresql"
  url          = env("DATABASE_URL")
}

enum UserRole {
  ADMIN
  USER
}

enum TransactionType {
  TOPUP       // Пополнение баланса
  DEDUCTION   // Списание за использование LLM
  ADJUSTMENT  // Ручная корректировка админом
  REFUND      // Возврат средств
}

model Account {
  id                String   @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?  @db.Text
  access_token      String?  @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?  @db.Text
  session_state     String?
  createdAt         DateTime @default(now()) @map(name: "created_at")
  updatedAt         DateTime @default(now()) @map(name: "updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
  @@map(name: "accounts")
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  
  // Session metadata
  userAgent    String?  @map("user_agent")
  ipAddress    String?  @map("ip_address")
  lastActivity DateTime @default(now()) @map("last_activity")
  createdAt    DateTime @default(now()) @map("created_at")
  
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map(name: "sessions")
}

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String?   @unique
  emailVerified DateTime?
  image         String?
  jobTitle      String?   @map(name: "job_title")
  timezone      String?   @default("utc+3")
  bio           String?   @db.Text
  password      String?   // Hashed password for credentials auth
  createdAt     DateTime  @default(now()) @map(name: "created_at")
  updatedAt     DateTime  @default(now()) @map(name: "updated_at")
  role          UserRole  @default(USER)

  // Token balance system
  tokenBalance  Decimal   @default(0) @map("token_balance") @db.Decimal(20, 2)

  accounts   Account[]
  sessions   Session[]
  agents     Agent[]
  tokenUsage TokenUsage[]

  stripeCustomerId       String?   @unique @map(name: "stripe_customer_id")
  stripeSubscriptionId   String?   @unique @map(name: "stripe_subscription_id")
  stripePriceId          String?   @map(name: "stripe_price_id")
  stripeCurrentPeriodEnd DateTime? @map(name: "stripe_current_period_end")

  userSessions UserSession[]
  libraryItems LibraryItem[]
  emailVerificationCodes EmailVerificationCode[]
  knowledgeConflicts KnowledgeConflict[]
  autoTestRuns AutoTestRun[]
  tokenTransactions TokenTransaction[]

  // PU Subscription System
  subscription UserSubscription?
  puTransactions PuTransaction[]
  puNotifications PuNotification[]
  frozenData FrozenData[]

  @@map(name: "users")
}

// Custom session tracking for JWT strategy
model UserSession {
  id           String   @id @default(cuid())
  userId       String   @map("user_id")
  jti          String   @unique // JWT ID for token identification
  
  userAgent    String?  @map("user_agent")
  ipAddress    String?  @map("ip_address")
  
  isRevoked    Boolean  @default(false) @map("is_revoked")
  lastActivity DateTime @default(now()) @map("last_activity")
  createdAt    DateTime @default(now()) @map("created_at")
  expiresAt    DateTime @map("expires_at")
  
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([jti])
  @@map("user_sessions")
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
  @@map(name: "verification_tokens")
}

model EmailVerificationCode {
  id        String   @id @default(cuid())
  userId    String   @map("user_id")
  code      String   @db.VarChar(6)
  expiresAt DateTime @map("expires_at")
  createdAt DateTime @default(now()) @map("created_at")
  
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  @@index([userId])
  @@index([code])
  @@map("email_verification_codes")
}

// ============================================
// Agent Models
// ============================================

enum AgentStatus {
  STOPPED
  STARTING
  RUNNING
  ERROR
}

model Agent {
  id              String      @id @default(cuid())
  userId          String
  name            String
  role            String
  description     String
  systemPrompt    String      @db.Text
  telegramToken   String?     // Encrypted bot token
  status          AgentStatus @default(STOPPED)
  containerId     String?
  containerName   String?
  createdAt       DateTime    @default(now()) @map(name: "created_at")
  updatedAt       DateTime    @updatedAt @map(name: "updated_at")
  
  // Behavior settings
  avatarEmoji     String?     @default("😊") @map(name: "avatar_emoji")
  displayName     String?     @map(name: "display_name")
  temperature     Float       @default(0.5)
  debounceMs      Int         @default(5000) @map("debounce_ms")
  tone            String[]    @default([])
  guardrails      Json?       @default("[]")
  welcomeMessage  String?     @map("welcome_message") // Message shown at session start
  
  // Schedule settings
  workSchedule    Json?       @map("work_schedule") // Weekly schedule: 7 arrays (Mon=0..Sun=6) x 24 booleans (hours 0-23)
  holidays        String[]    @default([]) // Holiday dates in DD.MM.YYYY format
  offlineMessage  String?     @map("offline_message") // Message during non-working hours
  
  user            User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  knowledgeBases  KnowledgeBase[]
  messages        AgentMessage[]
  summaries       AgentSummary[]
  tokenUsage      TokenUsage[]
  promptVersions  SystemPromptVersion[]
  notes           AgentNote[]
  testCases       AgentTestCase[]
  chatTestHistory ChatTestHistory[]
  fileQaQuestions FileQaQuestion[]
  autoTestRuns    AutoTestRun[]
  
  @@index([userId])
  @@map("agents")
}

model AgentTestCase {
  id             String   @id @default(cuid())
  agentId        String   @map("agent_id")
  question       String   @db.Text
  expectedAnswer String   @map("expected_answer") @db.Text
  createdAt      DateTime @default(now()) @map("created_at")
  
  agent          Agent    @relation(fields: [agentId], references: [id], onDelete: Cascade)
  
  @@index([agentId])
  @@map("agent_test_cases")
}

// Chat Test History - stores completed test sessions
model ChatTestHistory {
  id           String   @id @default(cuid())
  agentId      String   @map("agent_id")
  sessionId    String?  @map("session_id")
  messages     Json     // Array of {role, text, timestamp}
  messageCount Int      @default(0) @map("message_count")
  createdAt    DateTime @default(now()) @map("created_at")
  
  agent        Agent    @relation(fields: [agentId], references: [id], onDelete: Cascade)
  
  @@index([agentId])
  @@index([createdAt])
  @@map("chat_test_history")
}

// Auto-generated QA questions for files and instructions
model FileQaQuestion {
  id               String   @id @default(cuid())
  question         String   @db.Text
  expectedAnswer   String?  @map("expected_answer") @db.Text
  expectedReasoning String? @map("expected_reasoning") @db.Text // Why is this test tricky?
  
  sourceType       String   @map("source_type") // 'FILE' or 'INSTRUCTION'
  
  // Relations
  libraryItemId    String?  @map("library_item_id")
  libraryItem      LibraryItem? @relation(fields: [libraryItemId], references: [id], onDelete: Cascade)

  knowledgeBaseId  String?  @map("knowledge_base_id")
  knowledgeBase    KnowledgeBase? @relation(fields: [knowledgeBaseId], references: [id], onDelete: Cascade)
  
  agentId          String?  @map("agent_id")
  agent            Agent?   @relation(fields: [agentId], references: [id], onDelete: Cascade)
  
  createdAt        DateTime @default(now()) @map("created_at")
  
  @@index([libraryItemId])
  @@index([agentId])
  @@map("file_qa_questions")
}

model SystemPromptVersion {
  id           String   @id @default(cuid())
  agentId      String   @map(name: "agent_id")
  version      String   // e.g. "v1.0", "v1.1"
  content      String   @db.Text
  isActive     Boolean  @default(false) @map(name: "is_active")
  createdAt    DateTime @default(now()) @map(name: "created_at")
  
  agent        Agent    @relation(fields: [agentId], references: [id], onDelete: Cascade)
  
  @@index([agentId])
  @@map("system_prompt_versions")
}

model KnowledgeBase {
  id                  String           @id @default(cuid())
  agentId             String
  filename            String
  fileUrl             String?
  fileSize            Int
  mimeType            String
  status              KnowledgeStatus  @default(PENDING)
  chromaCollectionId  String?          @map(name: "chroma_collection_id")
  aiMetadata          Json?            @map("ai_metadata") // AI-generated file passport
  createdAt           DateTime         @default(now()) @map(name: "created_at")
  updatedAt           DateTime         @updatedAt @map(name: "updated_at")
  
  agent               Agent            @relation(fields: [agentId], references: [id], onDelete: Cascade)
  chunks              DocumentChunk[]
  qaQuestions         FileQaQuestion[]
  
  @@index([agentId])
  @@map("knowledge_bases")
}

enum KnowledgeStatus {
  PENDING      // Файл загружен, ждёт парсинга
  PARSED       // Чанки созданы, ждёт редактирования
  VECTORIZED   // Загружено в ChromaDB
  ERROR
}

model DocumentChunk {
  id              String        @id @default(cuid())
  knowledgeBaseId String
  content         String        @db.Text
  chunkIndex      Int           @map(name: "chunk_index")
  metadata        Json?         // Дополнительные данные (page, source, etc)
  createdAt       DateTime      @default(now()) @map(name: "created_at")
  updatedAt       DateTime      @updatedAt @map(name: "updated_at")
  
  knowledgeBase   KnowledgeBase @relation(fields: [knowledgeBaseId], references: [id], onDelete: Cascade)
  
  @@index([knowledgeBaseId])
  @@map("document_chunks")
}

// ============================================
// Token Usage Tracking
// ============================================

enum LlmRequestType {
  AGENT_CHAT        // Ответ агента пользователю
  INSTRUCTION_GEN   // Генерация инструкций
  TEST_GEN          // Генерация тестов
  SUMMARIZATION     // Суммаризация диалога
  CONFLICT_CHECK    // Проверка конфликтов
  RAG_QUERY         // RAG-запрос
  MANUAL_TEST       // Ручное тестирование
  OTHER             // Прочее
}

model TokenUsage {
  id               String   @id @default(uuid()) @db.Uuid
  userId           String
  promptTokens     Int      @default(0) @map(name: "prompt_tokens")
  completionTokens Int      @default(0) @map(name: "completion_tokens")
  totalTokens      Int      @default(0) @map(name: "total_tokens")
  model            String   @db.VarChar(100)
  agentId          String?  @map("agent_id") @db.VarChar(255)
  responseTimeMs   Int      @default(0) @map("response_time_ms")
  createdAt        DateTime @default(now()) @map(name: "created_at")
  isTest           Boolean  @default(false) @map("is_test") // True for test/manual API requests, excluded from analytics

  // Request type classification
  requestType      LlmRequestType @default(AGENT_CHAT) @map("request_type")

  // Token balance system
  platformTokensCharged  Decimal?  @map("platform_tokens_charged") @db.Decimal(20, 2)
  realCostUsd            Decimal?  @map("real_cost_usd") @db.Decimal(10, 6)

  user             User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  agent            Agent?   @relation(fields: [agentId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([agentId], map: "idx_token_usage_agent_id")
  @@index([createdAt])
  @@index([isTest], map: "idx_token_usage_is_test")
  @@index([requestType], map: "idx_token_usage_request_type")
  @@map("token_usage")
}

// ============================================
// Agent Conversation Context
// ============================================

enum MessageType {
  HUMAN
  AI
  TOOL
  SYSTEM
}

model AgentMessage {
  id             String      @id @default(cuid())
  agentId        String      @map("agent_id")
  telegramUserId BigInt      @map(name: "telegram_user_id")
  messageType    MessageType @map(name: "message_type")
  content        String      @db.Text
  createdAt      DateTime    @default(now()) @map(name: "created_at")
  isTest         Boolean     @default(false) @map("is_test") // True for test/manual API dialogs, excluded from analytics
  
  agent          Agent       @relation(fields: [agentId], references: [id], onDelete: Cascade)
  
  @@index([agentId, telegramUserId])
  @@index([createdAt])
  @@index([isTest], map: "idx_agent_messages_is_test")
  @@map("agent_messages")
}

model AgentSummary {
  id             String   @id @default(cuid())
  agentId        String   @map("agent_id")
  telegramUserId BigInt   @map(name: "telegram_user_id")
  summary        String   @db.Text
  createdAt      DateTime @default(now()) @map(name: "created_at")
  
  agent          Agent    @relation(fields: [agentId], references: [id], onDelete: Cascade)
  
  @@index([agentId, telegramUserId])
  @@map("agent_summaries")
}

model AgentNote {
  id        String   @id @default(cuid())
  agentId   String   @map("agent_id")
  title     String   @db.VarChar(255)
  content   String   @db.Text
  vectorId  String?  @map("vector_id") @db.VarChar(255)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at")

  agent     Agent    @relation(fields: [agentId], references: [id], onDelete: Cascade)

  @@index([agentId])
  @@map("agent_notes")
}

model LibraryItem {
  id        String   @id @default(cuid())
  userId    String   @map("user_id")
  name      String   @db.VarChar(255) // filename or note title
  type      String   @db.VarChar(50)  // 'FILE' or 'NOTE'
  content   String?  @db.Text         // for notes
  fileUrl   String?  @map("file_url") // for files
  fileSize  Int?     @map("file_size")
  mimeType  String?  @map("mime_type")
  status    KnowledgeStatus @default(PENDING)
  aiMetadata Json?   @map("ai_metadata") // AI-generated file passport
  createdAt DateTime @default(now()) @map("created_at")

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  chunks    LibraryChunk[]
  qaQuestions FileQaQuestion[]

  @@index([userId])
  @@map("library_items")
}

model LibraryChunk {
  id            String      @id @default(cuid())
  libraryItemId String      @map("library_item_id")
  content       String      @db.Text
  chunkIndex    Int         @map("chunk_index")
  metadata      Json?
  createdAt     DateTime    @default(now()) @map("created_at")

  libraryItem   LibraryItem @relation(fields: [libraryItemId], references: [id], onDelete: Cascade)

  @@index([libraryItemId])
  @@map("library_chunks")
}

// Global System Prompts - editable from admin panel
// Used for: test generation, agent creation templates, analysis prompts, etc.
model GlobalSystemPrompt {
  id          String   @id @default(cuid())
  key         String   @unique // e.g. "agent_creation_template", "test_generation", "analysis_prompt"
  name        String   // Display name: "Шаблон создания агента"
  description String?  @db.Text // Description of what this prompt is for
  usedIn      String?  @db.Text @map("used_in") // Where this prompt is used (file path or API endpoint)
  content     String   @db.Text // The actual prompt content
  isActive    Boolean  @default(true) @map("is_active")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  @@map("global_system_prompts")
}

// Knowledge Conflicts - detected by AI agents during RAG retrieval
enum ConflictStatus {
  NEW
  RESOLVED
  IGNORED
}

model KnowledgeConflict {
  id          String         @id @default(cuid())
  userId      String         @map("user_id")
  agentId     String?        @map("agent_id")
  chatId      String?        @map("chat_id")
  topic       String         // e.g. "Цена услуги", "Адрес офиса"
  details     Json           // Array of { file_id, file_name, value_found }
  status      ConflictStatus @default(NEW)
  detectedAt  DateTime       @default(now()) @map("detected_at")
  resolvedAt  DateTime?      @map("resolved_at")
  
  user        User           @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([status])
  @@index([detectedAt])
  @@map("knowledge_conflicts")
}

// Auto-Testing Models



model AutoTestRun {
  id        String   @id @default(cuid())
  agentId   String   @map("agent_id")
  userId    String   @map("user_id")
  status    String   // 'RUNNING', 'COMPLETED', 'FAILED'
  score     Int
  createdAt DateTime @default(now()) @map("created_at")

  agent     Agent    @relation(fields: [agentId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  results   AutoTestRunResult[]

  @@index([agentId])
  @@map("auto_test_runs")
}

model AutoTestRunResult {
  id              String      @id @default(cuid())
  runId           String      @map("run_id")
  question        String      @db.Text
  expectedAnswer  String      @db.Text @map("expected_answer")
  actualAnswer    String      @db.Text @map("actual_answer")
  passed          Boolean
  matchPercentage Int         @map("match_percentage")

  run             AutoTestRun @relation(fields: [runId], references: [id], onDelete: Cascade)

  @@index([runId])
  @@map("auto_test_run_results")
}

// ============================================
// Token Balance System
// ============================================

model TokenRateConfig {
  id                    String   @id @default(cuid())

  // Курс пополнения: сколько токенов платформы дается за 1 рубль
  rubToTokenRate        Decimal  @map("rub_to_token_rate") @db.Decimal(10, 2)

  // Курс расхода: сколько токенов платформы списывается за 1 токен LLM
  llmTokenToTokenRate   Decimal  @map("llm_token_to_token_rate") @db.Decimal(10, 4)

  isActive              Boolean  @default(false) @map("is_active")
  createdAt             DateTime @default(now()) @map("created_at")
  updatedBy             String   @map("updated_by") // userId админа

  @@index([isActive])
  @@map("token_rate_configs")
}

model ModelCostConfig {
  id                    String   @id @default(cuid())
  modelName             String   @map("model_name") // "gpt-4o", "claude-haiku-4"

  // Цена за 1 миллион токенов (в долларах)
  inputCostPerMillion   Decimal  @map("input_cost_per_million") @db.Decimal(10, 4)
  outputCostPerMillion  Decimal  @map("output_cost_per_million") @db.Decimal(10, 4)

  isActive              Boolean  @default(true) @map("is_active")
  createdAt             DateTime @default(now()) @map("created_at")
  updatedBy             String   @map("updated_by")

  @@unique([modelName, isActive])
  @@index([modelName])
  @@map("model_cost_configs")
}

model TokenTransaction {
  id                    String          @id @default(cuid())
  userId                String          @map("user_id")
  type                  TransactionType
  amount                Decimal         @db.Decimal(20, 2) // Может быть отрицательным для списаний
  balanceBefore         Decimal         @map("balance_before") @db.Decimal(20, 2)
  balanceAfter          Decimal         @map("balance_after") @db.Decimal(20, 2)

  // Дополнительные данные
  description           String?         @db.Text
  metadata              Json?           // { stripePaymentId, agentId, tokenUsageId, etc }

  createdAt             DateTime        @default(now()) @map("created_at")
  createdBy             String?         @map("created_by") // userId админа для ADJUSTMENT

  user                  User            @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([type])
  @@index([createdAt])
  @@map("token_transactions")
}

// ============================================
// PU Subscription System
// ============================================

enum PuTransactionType {
  SUBSCRIPTION_GRANT  // Начисление по подписке
  OVERAGE_DEDUCTION   // Списание за использование
  PACK_TOPUP          // Покупка пакета
  ADMIN_ADJUSTMENT    // Ручная корректировка
  REFUND              // Возврат
  RESET               // Сброс цикла (сжигание остатка)
}

enum PuNotificationType {
  WARNING_80_PERCENT
  LIMIT_REACHED
  OVERDRAFT_WARNING
  SERVICE_BLOCKED
}

enum SubscriptionStatus {
  ACTIVE      // Активна
  PAST_DUE    // Просрочка платежа
  CANCELED    // Отменена
  SUSPENDED   // Приостановлена
  FROZEN      // Заморожена (данные недоступны)
}

model SubscriptionPlan {
  id                    String   @id @default(cuid())
  code                  String   @unique // 'BASIC', 'PRO', 'BUSINESS', 'ENTERPRISE'
  name                  String   // Display name in Russian

  monthlyPuLimit        Decimal  @map("monthly_pu_limit") @db.Decimal(10, 2)
  priceMonthlyRub       Decimal  @map("price_monthly_rub") @db.Decimal(10, 2)

  // Overage pricing
  overagePuPriceRub     Decimal  @map("overage_pu_price_rub") @db.Decimal(10, 2)
  overageDialogPriceRub Decimal  @map("overage_dialog_price_rub") @db.Decimal(10, 2)

  // Plan features
  features              Json     @default("[]") // Array of feature descriptions
  stripePriceId         String?  @map("stripe_price_id")

  isActive              Boolean  @default(true) @map("is_active")
  displayOrder          Int      @default(0) @map("display_order")

  createdAt             DateTime @default(now()) @map("created_at")
  updatedAt             DateTime @updatedAt @map("updated_at")

  users                 UserSubscription[]

  @@index([isActive])
  @@index([displayOrder])
  @@map("subscription_plans")
}

model UserSubscription {
  id                    String   @id @default(cuid())
  userId                String   @unique @map("user_id")
  planId                String   @map("plan_id")

  // PU Balance tracking
  puBalance             Decimal  @map("pu_balance") @db.Decimal(12, 4)
  puLimit               Decimal  @map("pu_limit") @db.Decimal(10, 2) // Snapshot of plan limit

  // Billing cycle management
  billingCycleStartDate DateTime @map("billing_cycle_start_date")
  nextResetDate         DateTime @map("next_reset_date")

  // Stripe integration
  stripeSubscriptionId  String?  @unique @map("stripe_subscription_id")
  stripeStatus          String?  @map("stripe_status") // 'active', 'past_due', 'canceled', etc.

  // Usage tracking this cycle
  puUsedThisCycle       Decimal  @default(0) @map("pu_used_this_cycle") @db.Decimal(12, 4)
  overagePuUsed         Decimal  @default(0) @map("overage_pu_used") @db.Decimal(12, 4)

  // Overdraft management
  isOverdraft           Boolean  @default(false) @map("is_overdraft")
  isBlocked             Boolean  @default(false) @map("is_blocked")

  // Status
  status                SubscriptionStatus @default(ACTIVE)

  createdAt             DateTime @default(now()) @map("created_at")
  updatedAt             DateTime @updatedAt @map("updated_at")

  user                  User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  plan                  SubscriptionPlan @relation(fields: [planId], references: [id])

  @@index([planId])
  @@index([nextResetDate])
  @@index([isBlocked])
  @@map("user_subscriptions")
}

model PuTransaction {
  id              String         @id @default(cuid())
  userId          String         @map("user_id")
  type            PuTransactionType

  // PU amounts
  puAmount        Decimal        @db.Decimal(12, 4) // Can be negative for deductions
  balanceBefore   Decimal        @map("balance_before") @db.Decimal(12, 4)
  balanceAfter    Decimal        @map("balance_after") @db.Decimal(12, 4)

  // Source tracking
  source          String?        // 'SUBSCRIPTION_RESET', 'OVERAGE_PACK', 'LLM_USAGE', 'VECTORIZATION', 'ADMIN_ADJUSTMENT'
  description     String?        @db.Text
  metadata        Json?          // { model, tokens, requestType, agentId, etc. }

  // Billing
  billingCycleDate DateTime?    @map("billing_cycle_date") // Which cycle this belongs to
  costRub         Decimal?       @map("cost_rub") @db.Decimal(10, 2) // For overage charges

  createdAt       DateTime       @default(now()) @map("created_at")
  createdBy       String?        @map("created_by") // Admin userId if manual

  user            User           @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([type])
  @@index([createdAt])
  @@index([billingCycleDate])
  @@map("pu_transactions")
}

model PuNotification {
  id              String   @id @default(cuid())
  userId          String   @map("user_id")
  type            PuNotificationType

  // Notification context
  puBalance       Decimal  @map("pu_balance") @db.Decimal(12, 4)
  puLimit         Decimal  @map("pu_limit") @db.Decimal(10, 2)
  usagePercent    Int      @map("usage_percent")

  // Delivery
  wasSent         Boolean  @default(false) @map("was_sent")
  sentAt          DateTime? @map("sent_at")
  channel         String?  // 'EMAIL', 'IN_APP', 'WEBHOOK'

  // Deduplication
  billingCycleDate DateTime @map("billing_cycle_date")

  createdAt       DateTime @default(now()) @map("created_at")

  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, type, billingCycleDate])
  @@index([userId])
  @@index([wasSent])
  @@map("pu_notifications")
}

model FileProcessingCache {
  id                  String   @id @default(cuid())
  agentId             String   @map("agent_id")

  // File identification
  filename            String
  contentHash         String   @map("content_hash") @db.VarChar(64) // SHA-256
  fileSize            Int      @map("file_size")

  // Processing details
  chunkCount          Int      @map("chunk_count")
  puCharged           Decimal  @map("pu_charged") @db.Decimal(10, 4)
  vectorizationDate   DateTime @map("vectorization_date")

  // Version tracking
  previousVersion     String?  @map("previous_version") // contentHash of previous version
  diffPercentage      Int?     @map("diff_percentage") // 0-100
  chargePercentage    Int      @map("charge_percentage") // 0, 20, 70, 100

  // Metadata
  metadata            Json?

  createdAt           DateTime @default(now()) @map("created_at")

  @@unique([agentId, contentHash])
  @@index([agentId])
  @@index([contentHash])
  @@map("file_processing_cache")
}

model FrozenData {
  id                String   @id @default(cuid())
  userId            String   @map("user_id")

  // What was frozen
  resourceType      String   // 'KNOWLEDGE_BASE', 'LIBRARY_ITEM', 'AGENT'
  resourceId        String   @map("resource_id")

  // Original plan
  planCodeRequired  String   @map("plan_code_required") // Какой план нужен для разморозки
  puSizeEstimate    Decimal  @map("pu_size_estimate") @db.Decimal(10, 2) // Сколько PU занимает

  // Timeline
  frozenAt          DateTime @default(now()) @map("frozen_at")
  deleteScheduledAt DateTime @map("delete_scheduled_at") // frozenAt + 30 days

  // Metadata
  metadata          Json?    // { filename, agentName, etc. }

  user              User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([deleteScheduledAt])
  @@map("frozen_data")
}
