# -----------------------------------------------------------------------------
# App
# -----------------------------------------------------------------------------
NEXT_PUBLIC_APP_URL=http://144.124.249.196:3000

# -----------------------------------------------------------------------------
# Database (PostgreSQL)
# -----------------------------------------------------------------------------
DATABASE_URL=postgresql://leo:leo_password@db:5432/leo?schema=public

# -----------------------------------------------------------------------------
# Authentication (NextAuth.js / Auth.js)
# -----------------------------------------------------------------------------
# Минимум 32 символа, можно сгенерировать: openssl rand -base64 32
AUTH_SECRET=your-auth-secret-min-32-chars-here-change-me
AUTH_TRUST_HOST=true

# Google OAuth
# Получить: https://console.cloud.google.com/apis/credentials -> Create OAuth 2.0 Client ID
# Redirect URI: http://localhost:3000/api/auth/callback/google
GOOGLE_CLIENT_ID=1
GOOGLE_CLIENT_SECRET=secret

# GitHub Personal Access Token
# Получить: https://github.com/settings/tokens -> Generate new token
GITHUB_OAUTH_TOKEN=github_token

# -----------------------------------------------------------------------------
# Email (Resend)
# -----------------------------------------------------------------------------
# Получить: https://resend.com -> API Keys
RESEND_API_KEY=re_ZjtoecVk_MgEDbXNVrMk7ArLuNETWu3KL
EMAIL_FROM=onboarding@resend.dev

# -----------------------------------------------------------------------------
# Stripe (Платежи)
# -----------------------------------------------------------------------------
# Получить: https://dashboard.stripe.com/apikeys
# Secret key (sk_test_... или sk_live_...)
STRIPE_API_KEY=api_key

# Webhook secret: Stripe Dashboard -> Webhooks -> добавить endpoint -> Signing secret
# Endpoint URL: https://your-domain.com/api/webhooks/stripe
STRIPE_WEBHOOK_SECRET=secret

# Price IDs для тарифных планов
# Создать: Stripe Dashboard -> Products -> Add product -> получить Price ID (price_...)
NEXT_PUBLIC_STRIPE_PRO_MONTHLY_PLAN_ID=1
NEXT_PUBLIC_STRIPE_PRO_YEARLY_PLAN_ID=1
NEXT_PUBLIC_STRIPE_BUSINESS_MONTHLY_PLAN_ID=1
NEXT_PUBLIC_STRIPE_BUSINESS_YEARLY_PLAN_ID=1


# Client-Side (Browser) -> Must use Public IP
NEXT_PUBLIC_AGENT_ORCHESTRATOR_URL=http://144.124.249.196:8081
NEXT_PUBLIC_AI_GATEWAY_URL=http://144.124.249.196:8080

# Server-Side (Docker Container) -> Connects to Host via gateway
AI_GATEWAY_URL=http://144.124.249.196:8080
AGENT_ORCHESTRATOR_URL=http://144.124.249.196:8081

